<UserControl x:Class="AutoCAD.SGH.UI.SghWordPreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="1200" d:DesignWidth="680"
             Background="#E5E7EB"
             FontFamily="Arial Narrow, Arial, Segoe UI, sans-serif"
             FontSize="12">

    <UserControl.Resources>
        <!-- Sombra realista de página de documento Word -->
        <DropShadowEffect x:Key="WordPaperShadow" BlurRadius="12" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.25"/>

        <!-- Estilo de botones de navegación estilo Office / Word -->
        <Style x:Key="WordNavButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo de botón para control de zoom -->
        <Style x:Key="WordZoomButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Barra de herramientas superior estilo visor Microsoft Word -->
            <RowDefinition Height="Auto"/>
            <!-- Contenedor con scroll para visualizar todo el documento A4 continuo -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra de herramientas superior estilo visor Word / Office -->
        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="12,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Icono azul corporativo Word -->
                    <Border Background="#2B579A" CornerRadius="3" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="W" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="VISTA PREVIA DEL INFORME WORD" FontWeight="Bold" FontSize="11" Foreground="#1E3A8A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Border Background="#E2E8F0" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="SGH-INF-001.docx (A4)" FontSize="9.5" FontWeight="SemiBold" Foreground="#475569"/>
                    </Border>
                </StackPanel>

                <!-- Chips de navegación rápida entre páginas del documento Word -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Ir a:" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <Button x:Name="BtnNav1" Style="{StaticResource WordNavButtonStyle}" Content="1. Portada" Click="BtnJumpSection_Click" Tag="1" ToolTip="Ir a Portada y Control de Aprobaciones"/>
                    <Button x:Name="BtnNav2" Style="{StaticResource WordNavButtonStyle}" Content="2. Contenido" Click="BtnJumpSection_Click" Tag="2" ToolTip="Ir a Tabla de Contenido e Introducción"/>
                    <Button x:Name="BtnNav3" Style="{StaticResource WordNavButtonStyle}" Content="3. Clasificación" Click="BtnJumpSection_Click" Tag="3" ToolTip="Ir a Clasificación y Altura"/>
                    <Button x:Name="BtnNav4" Style="{StaticResource WordNavButtonStyle}" Content="4. Salidas" Click="BtnJumpSection_Click" Tag="4" ToolTip="Ir a Salidas y Evacuación por Piso"/>
                    <Button x:Name="BtnNav5" Style="{StaticResource WordNavButtonStyle}" Content="5. Conclusiones" Click="BtnJumpSection_Click" Tag="5" ToolTip="Ir a Conclusiones y Localización"/>

                    <!-- Separador -->
                    <Rectangle Width="1" Height="16" Fill="#CBD5E1" Margin="6,0,6,0"/>

                    <!-- Control de Zoom rápido -->
                    <Button x:Name="BtnZoomOut" Style="{StaticResource WordZoomButtonStyle}" Content="−" Width="22" Click="BtnZoomOut_Click" ToolTip="Reducir zoom"/>
                    <TextBlock x:Name="TxtZoomLevel" Text="100%" FontSize="10" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="4,0" MinWidth="34" TextAlignment="Center"/>
                    <Button x:Name="BtnZoomIn" Style="{StaticResource WordZoomButtonStyle}" Content="+" Width="22" Click="BtnZoomIn_Click" ToolTip="Aumentar zoom"/>
                    <Button x:Name="BtnZoomReset" Style="{StaticResource WordZoomButtonStyle}" Content="100%" Margin="4,0,0,0" Click="BtnZoomReset_Click" ToolTip="Restablecer tamaño original"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contenedor de la vista continua del Documento con fondo gris de Microsoft Word -->
        <ScrollViewer x:Name="DocScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#E5E7EB" PreviewMouseWheel="DocScrollViewer_PreviewMouseWheel">
            <!-- Contenedor con transformación de escala para el zoom -->
            <StackPanel x:Name="PnlDocContainer" HorizontalAlignment="Center" Margin="20,18">
                <StackPanel.LayoutTransform>
                    <ScaleTransform x:Name="DocScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
                </StackPanel.LayoutTransform>

                <!-- ============================================================== -->
                <!-- HOJA 1: PORTADA & CONTROL DE APROBACIONES (PLANTILLA OFICIAL) -->
                <!-- ============================================================== -->
                <Border x:Name="Sheet1" Width="595" MinHeight="842" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Effect="{StaticResource WordPaperShadow}" Padding="42,34,42,30" Margin="0,0,0,26">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ENCABEZADO INSTITUCIONAL OFICIAL (Tabla DICTA S.A.S.) -->
                        <Border Grid.Row="0" BorderBrush="#000000" BorderThickness="1" Margin="0,0,0,18" Background="#FFFFFF">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="105"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="115"/>
                                </Grid.ColumnDefinitions>

                                <!-- Columna 1: Logo DICTA -->
                                <Border Grid.Column="0" BorderBrush="#000000" BorderThickness="0,0,1,0" Padding="6,4">
                                    <Grid Height="40">
                                        <Image x:Name="ImgLogoHeader1" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtFallbackLogo1" Text="DICTA S.A.S." FontWeight="Bold" FontSize="10" Foreground="#1E3A8A" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>

                                <!-- Columna 2: Título central -->
                                <Border Grid.Column="1" BorderBrush="#000000" BorderThickness="0,0,1,0" Padding="8,4" VerticalAlignment="Center">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="INFORME" FontSize="11" FontWeight="Bold" Foreground="#000000" HorizontalAlignment="Center"/>
                                        <TextBlock Text="DISEÑO Y COORDINACIÓN" FontSize="8" Foreground="#333333" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Columna 3: Control documental oficial -->
                                <Border Grid.Column="2" Padding="6,3" VerticalAlignment="Center">
                                    <StackPanel HorizontalAlignment="Left">
                                        <TextBlock Text="Cód: COO-FR-002" FontSize="7.5" Foreground="#000000"/>
                                        <TextBlock x:Name="TxtHeaderDate1" Text="Fecha: 20/01/25" FontSize="7.5" Foreground="#000000"/>
                                        <TextBlock x:Name="TxtHeaderVersion1" Text="Versión: 2.2" FontSize="7.5" Foreground="#000000"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- CUERPO DE LA PORTADA -->
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="INFORME" FontSize="12" FontWeight="Bold" Foreground="#000000" HorizontalAlignment="Center" Margin="0,6,0,2"/>
                            <TextBlock Text="ESTUDIO DE SEGURIDAD HUMANA" FontSize="16" FontWeight="Bold" Foreground="#006FC0" HorizontalAlignment="Center" Margin="0,0,0,6"/>

                            <TextBlock x:Name="TxtPrevProjectName" Text="NOMBRE DE PROYECTO" FontSize="14" FontWeight="Bold" Foreground="#000000" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <TextBlock x:Name="TxtPrevProjectDesc" Text="Descripción del proyecto y alcances de la edificación analizada bajo normativa NSR-10 y NFPA 101." FontSize="9.5" Foreground="#1F2937" TextAlignment="Justify" TextWrapping="Wrap" LineHeight="14" Margin="0,0,0,16"/>

                            <!-- Cuadrícula de Datos de Equipo (Alineación con tabulador Word) -->
                            <Border BorderBrush="#CCCCCC" BorderThickness="1" Padding="12,10" Background="#FFFFFF" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="165"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Director del proyecto:" FontWeight="Bold" FontSize="9.5" Foreground="#000000" Margin="0,2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtPrevDirector" Text="Ing. Pedro Diaz" FontSize="9.5" Foreground="#000000" Margin="0,2"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Certificado NFPA:" FontWeight="Bold" FontSize="9.5" Foreground="#000000" Margin="0,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtPrevCert" Text="Certificado NFPA 1 &amp; 101 &amp; 72" FontSize="9.5" Foreground="#000000" Margin="0,2"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Coordinador del proyecto:" FontWeight="Bold" FontSize="9.5" Foreground="#000000" Margin="0,2"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtPrevCoordinator" Text="COORDINADOR" FontSize="9.5" Foreground="#000000" Margin="0,2"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Elaborado por:" FontWeight="Bold" FontSize="9.5" Foreground="#000000" Margin="0,2"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtPrevAuthor" Text="ELABORADOR" FontSize="9.5" Foreground="#000000" Margin="0,2"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Colaborador:" FontWeight="Bold" FontSize="9.5" Foreground="#000000" Margin="0,2"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtPrevCollaborator" Text="COLABORADOR" FontSize="9.5" Foreground="#000000" Margin="0,2"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Fecha:" FontWeight="Bold" FontSize="9.5" Foreground="#000000" Margin="0,2"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="TxtPrevDate" Text="2026/10/19" FontWeight="Bold" FontSize="9.5" Foreground="#000000" Margin="0,2"/>
                                </Grid>
                            </Border>

                            <!-- TABLA OFICIAL WORD: CONTROL DE APROBACIONES (Colores Oficiales #4C6674 y #7C93A0) -->
                            <TextBlock Text="CONTROL DE APROBACIONES" FontSize="9" FontWeight="Bold" Foreground="#000000" Margin="0,0,0,4"/>
                            <Border BorderBrush="#000000" BorderThickness="1" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Fila de Encabezado Oficial (#4C6674) -->
                                    <Border Grid.Row="0" Grid.ColumnSpan="5" Background="#4C6674" BorderBrush="#000000" BorderThickness="0,0,0,1" Padding="4,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Rol" FontWeight="Bold" FontSize="8.5" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Cargo" FontWeight="Bold" FontSize="8.5" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="Nombre" FontWeight="Bold" FontSize="8.5" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="Fecha" FontWeight="Bold" FontSize="8.5" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="Firma" FontWeight="Bold" FontSize="8.5" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Fila Elaboró (Fondo Blanco) -->
                                    <Border Grid.Row="1" Grid.ColumnSpan="5" BorderBrush="#000000" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Elaboró" FontWeight="Bold" FontSize="8" Foreground="#000000" Margin="4,2.5" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" x:Name="TxtPrevElabCargo" Text="Coordinadora Senior" FontSize="8" Foreground="#000000" Margin="4,2.5"/>
                                            <TextBlock Grid.Column="2" x:Name="TxtPrevElabNombre" Text="Alejandra Velandia" FontSize="8" Foreground="#000000" Margin="4,2.5"/>
                                            <TextBlock Grid.Column="3" x:Name="TxtPrevElabFecha" Text="2026/10/19" FontSize="8" Foreground="#000000" Margin="4,2.5" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="" FontSize="8" Margin="4,2.5"/>
                                        </Grid>
                                    </Border>

                                    <!-- Fila Revisó (Fondo Gris Azulado Oficial #7C93A0 o tono suave) -->
                                    <Border Grid.Row="2" Grid.ColumnSpan="5" Background="#EEF2F6" BorderBrush="#000000" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Revisó" FontWeight="Bold" FontSize="8" Foreground="#000000" Margin="4,2.5" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" x:Name="TxtPrevRevCargo" Text="Responsable de SGC" FontSize="8" Foreground="#000000" Margin="4,2.5"/>
                                            <TextBlock Grid.Column="2" x:Name="TxtPrevRevNombre" Text="Catherin Zamora" FontSize="8" Foreground="#000000" Margin="4,2.5"/>
                                            <TextBlock Grid.Column="3" x:Name="TxtPrevRevFecha" Text="2026/10/19" FontSize="8" Foreground="#000000" Margin="4,2.5" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="" FontSize="8" Margin="4,2.5"/>
                                        </Grid>
                                    </Border>

                                    <!-- Fila Aprobó (Fondo Blanco) -->
                                    <Border Grid.Row="3" Grid.ColumnSpan="5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Aprobó" FontWeight="Bold" FontSize="8" Foreground="#000000" Margin="4,2.5" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" x:Name="TxtPrevAproCargo" Text="Responsable de SGC" FontSize="8" Foreground="#000000" Margin="4,2.5"/>
                                            <TextBlock Grid.Column="2" x:Name="TxtPrevAproNombre" Text="Catherin Zamora" FontSize="8" Foreground="#000000" Margin="4,2.5"/>
                                            <TextBlock Grid.Column="3" x:Name="TxtPrevAproFecha" Text="2026/10/19" FontSize="8" Foreground="#000000" Margin="4,2.5" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="" FontSize="8" Margin="4,2.5"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- TABLA OFICIAL WORD: HISTORIAL DEL DOCUMENTO -->
                            <TextBlock Text="HISTORIAL DEL DOCUMENTO" FontSize="9" FontWeight="Bold" Foreground="#000000" Margin="0,0,0,4"/>
                            <Border BorderBrush="#000000" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Header Historial -->
                                    <Border Grid.Row="0" Grid.ColumnSpan="4" Background="#D9D9D9" BorderBrush="#000000" BorderThickness="0,0,0,1" Padding="4,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Versión" FontWeight="Bold" FontSize="8" Foreground="#000000" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Descripción del cambio" FontWeight="Bold" FontSize="8" Foreground="#000000" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="Fecha" FontWeight="Bold" FontSize="8" Foreground="#000000" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="Aprobado" FontWeight="Bold" FontSize="8" Foreground="#000000" HorizontalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Fila Historial -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" x:Name="TxtHistVersion" Text="01" FontSize="8" Foreground="#000000" Margin="4,2.5" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Emisión del documento" FontSize="8" Foreground="#000000" Margin="4,2.5"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" x:Name="TxtHistDate" Text="2026/10/19" FontSize="8" Foreground="#000000" Margin="4,2.5" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="3" x:Name="TxtHistApproved" Text="Catherin Zamora" FontSize="8" Foreground="#000000" Margin="4,2.5" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- PIE DE PÁGINA INSTITUCIONAL OFICIAL WORD (Hoja 1) -->
                        <Grid Grid.Row="2" Margin="0,18,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="FA-COD-SGH-INF-001" FontSize="8" Foreground="#333333"/>
                                <TextBlock Grid.Column="1" Text="Página 1 de 5" FontSize="8" Foreground="#333333" HorizontalAlignment="Right"/>
                            </Grid>
                            <!-- Barra Institucional Gráfica DICTA -->
                            <Image Grid.Row="1" x:Name="ImgFooterBar1" Height="10" Stretch="Fill"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ============================================================== -->
                <!-- HOJA 2: TABLA DE CONTENIDO & 1. INTRODUCCIÓN                   -->
                <!-- ============================================================== -->
                <Border x:Name="Sheet2" Width="595" MinHeight="842" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Effect="{StaticResource WordPaperShadow}" Padding="42,34,42,30" Margin="0,0,0,26">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ENCABEZADO INSTITUCIONAL OFICIAL (Hoja 2) -->
                        <Border Grid.Row="0" BorderBrush="#000000" BorderThickness="1" Margin="0,0,0,18" Background="#FFFFFF">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="105"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="115"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" BorderBrush="#000000" BorderThickness="0,0,1,0" Padding="6,4">
                                    <Grid Height="40">
                                        <Image x:Name="ImgLogoHeader2" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtFallbackLogo2" Text="DICTA S.A.S." FontWeight="Bold" FontSize="10" Foreground="#1E3A8A" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="1" BorderBrush="#000000" BorderThickness="0,0,1,0" Padding="8,4" VerticalAlignment="Center">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="INFORME" FontSize="11" FontWeight="Bold" Foreground="#000000" HorizontalAlignment="Center"/>
                                        <TextBlock Text="DISEÑO Y COORDINACIÓN" FontSize="8" Foreground="#333333" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Padding="6,3" VerticalAlignment="Center">
                                    <StackPanel HorizontalAlignment="Left">
                                        <TextBlock Text="Cód: COO-FR-002" FontSize="7.5" Foreground="#000000"/>
                                        <TextBlock x:Name="TxtHeaderDate2" Text="Fecha: 20/01/25" FontSize="7.5" Foreground="#000000"/>
                                        <TextBlock x:Name="TxtHeaderVersion2" Text="Versión: 2.2" FontSize="7.5" Foreground="#000000"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- CUERPO HOJA 2 -->
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="TABLA DE CONTENIDO" FontSize="12" FontWeight="Bold" Foreground="#000000" Margin="0,0,0,8"/>

                            <!-- Párrafos de Tabla de Contenido oficial Word con líneas de puntos líder -->
                            <StackPanel Margin="0,0,0,16">
