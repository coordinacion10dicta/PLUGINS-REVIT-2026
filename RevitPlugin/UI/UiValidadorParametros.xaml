<Window x:Class="MiNamespace.UI.UiValidadorParametros"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Validador de Parámetros — DICTA"
        Height="640" Width="980"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="#2D6A4F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1B4332"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnSecondary" TargetType="Button">
            <Setter Property="Background" Value="#455A64"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#263238"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnAutoFix" TargetType="Button">
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0D47A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Color por tipo de problema -->
        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding TipoDeProblema}" Value="ParametroFaltante">
                    <Setter Property="Background" Value="#FFEBEE"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding TipoDeProblema}" Value="ValorVacio">
                    <Setter Property="Background" Value="#FFF8E1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding TipoDeProblema}" Value="NombreIncorrecto">
                    <Setter Property="Background" Value="#FFF3E0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding TipoDeProblema}" Value="Duplicado">
                    <Setter Property="Background" Value="#E8EAF6"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Border Grid.Row="0" Background="#1A237E" CornerRadius="4" Padding="14,10" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Validador de Parámetros"
                           FontSize="18" FontWeight="Bold" Foreground="White"
                           VerticalAlignment="Center"/>
                <TextBlock Text="  |  Listo para Presupuesto"
                           FontSize="12" Foreground="#90CAF9"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Fila: Archivo Excel -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Archivo de parámetros:" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" x:Name="txtExcelPath" IsReadOnly="True"
                     VerticalContentAlignment="Center" Padding="6,4"
                     FontSize="11" Foreground="#555" Background="#F5F5F5"
                     BorderBrush="#BDBDBD"/>
            <Button Grid.Column="2" Content="Examinar..." Style="{StaticResource BtnSecondary}"
                    Margin="6,0,0,0" Click="BtnExaminar_Click"/>
            <Button Grid.Column="3" Content="Crear plantilla" Style="{StaticResource BtnSecondary}"
                    Margin="4,0,0,0" Click="BtnCrearPlantilla_Click"
                    ToolTip="Crea ParametrosRequeridos.xlsx con datos de ejemplo en la carpeta del DLL"/>
        </Grid>

        <!-- Fila: Disciplina + Validar -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Disciplina:" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Grid.Column="1" x:Name="cboDisciplina"
                      VerticalContentAlignment="Center" Padding="6,4" FontSize="12"/>
            <Button Grid.Column="3" Content="EJECUTAR VALIDACIÓN"
                    Style="{StaticResource BtnPrimary}"
                    Click="BtnValidar_Click"/>
        </Grid>

        <Separator Grid.Row="3" Margin="0,0,0,8"/>

        <!-- DataGrid de resultados -->
        <DataGrid Grid.Row="4"
                  x:Name="dgResultados"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  SelectionMode="Extended"
                  FontSize="11"
                  ColumnHeaderHeight="28">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#ECEFF1"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="BorderBrush" Value="#CFD8DC"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"        Binding="{Binding ElementId}"        Width="70"/>
                <DataGridTextColumn Header="Familia"   Binding="{Binding Familia}"           Width="150"/>
                <DataGridTextColumn Header="Tipo"      Binding="{Binding Tipo}"              Width="120"/>
                <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}"         Width="130"/>
                <DataGridTextColumn Header="Parámetro" Binding="{Binding Parametro}"         Width="140"/>
                <DataGridTextColumn Header="Problema"  Binding="{Binding TipoProblemaTexto}" Width="140"/>
                <DataGridTextColumn Header="Descripción" Binding="{Binding DescripcionProblema}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Leyenda y resumen -->
        <Border Grid.Row="5" Background="#ECEFF1" CornerRadius="4" Padding="10,7" Margin="0,8,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="lblResumen"
                           Text="Ejecute la validación para ver los resultados."
                           FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Margin="0,0,4,0"><Run Text="■" Foreground="#EF9A9A"/><Run Text=" Faltante"/></TextBlock>
                    <TextBlock Margin="8,0,4,0"><Run Text="■" Foreground="#FFE082"/><Run Text=" Vacío"/></TextBlock>
                    <TextBlock Margin="8,0,4,0"><Run Text="■" Foreground="#FFCC80"/><Run Text=" Nombre incorrecto"/></TextBlock>
                    <TextBlock Margin="8,0,0,0"><Run Text="■" Foreground="#9FA8DA"/><Run Text=" Duplicado"/></TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Pie: status + Auto Fix -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="lblStatus"
                       FontSize="11" Foreground="#757575"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1"
                    Content="⚡  EJECUTAR AUTO FIX"
                    Style="{StaticResource BtnAutoFix}"
                    ToolTip="Corrección automática de parámetros (función en desarrollo)"
                    Click="BtnAutoFix_Click"/>
        </Grid>
    </Grid>
</Window>
