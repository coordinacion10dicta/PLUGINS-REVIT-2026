<Window x:Class="MiNamespace.UI.UiValidadorParametros"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Validador de Parámetros — DICTA"
        Height="700" Width="1200"
        MinHeight="500" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="#2D6A4F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1B4332"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnSecondary" TargetType="Button">
            <Setter Property="Background" Value="#455A64"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#263238"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnAction" TargetType="Button">
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0D47A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Border Grid.Row="0" Background="#1A237E" CornerRadius="4" Padding="14,10" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Validador de Parámetros"
                           FontSize="18" FontWeight="Bold" Foreground="White"
                           VerticalAlignment="Center"/>
                <TextBlock Text="  |  Edición y Validación"
                           FontSize="12" Foreground="#90CAF9"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Fila: Archivo Excel -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Archivo de parámetros:" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" x:Name="txtExcelPath" IsReadOnly="True"
                     VerticalContentAlignment="Center" Padding="6,4"
                     FontSize="11" Foreground="#555" Background="#F5F5F5"
                     BorderBrush="#BDBDBD"/>
            <Button Grid.Column="2" Content="Examinar..." Style="{StaticResource BtnSecondary}"
                    Margin="6,0,0,0" Click="BtnExaminar_Click"/>
            <Button Grid.Column="3" Content="Crear plantilla" Style="{StaticResource BtnSecondary}"
                    Margin="4,0,0,0" Click="BtnCrearPlantilla_Click"/>
            <Button Grid.Column="4" Content="Editar Excel" Style="{StaticResource BtnAction}"
                    Margin="4,0,0,0" Click="BtnEditarExcel_Click"
                    ToolTip="Abre el archivo Excel para editar las reglas"/>
        </Grid>

        <!-- Fila: Disciplina + Validar -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Disciplina:" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Grid.Column="1" x:Name="cboDisciplina"
                      VerticalContentAlignment="Center" Padding="6,4" FontSize="12"/>
            <Button Grid.Column="3" Content="EJECUTAR VALIDACIÓN"
                    Style="{StaticResource BtnPrimary}"
                    Click="BtnValidar_Click"/>
        </Grid>

        <Separator Grid.Row="3" Margin="0,0,0,8"/>

        <!-- Área principal: Grid izquierda + Panel edición derecha -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="380" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- DataGrid de resultados (izquierda) -->
            <DataGrid Grid.Column="0"
                      x:Name="dgResultados"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      SelectionMode="Single"
                      SelectionChangedEvent="DgResultados_SelectionChanged"
                      FontSize="11"
                      ColumnHeaderHeight="28">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#ECEFF1"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="BorderBrush" Value="#CFD8DC"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"        Binding="{Binding ElementId}"        Width="60"/>
                    <DataGridTextColumn Header="Familia"   Binding="{Binding Familia}"           Width="120"/>
                    <DataGridTextColumn Header="Parámetro" Binding="{Binding Parametro}"         Width="130"/>
                    <DataGridTextColumn Header="Problema"  Binding="{Binding TipoProblemaTexto}" Width="110"/>
                    <DataGridTextColumn Header="Descripción" Binding="{Binding DescripcionProblema}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Separador vertical -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="#E0E0E0" Cursor="SizeWE"/>

            <!-- Panel de edición (derecha) -->
            <Border Grid.Column="2" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Título panel -->
                    <TextBlock Grid.Row="0" Text="EDITAR PARÁMETROS"
                               FontWeight="Bold" FontSize="12"
                               Foreground="#1A237E" Margin="0,0,0,10"/>

                    <!-- Info del elemento seleccionado -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <TextBlock Text="Elemento:"  FontWeight="SemiBold" FontSize="10" Foreground="#666"/>
                        <TextBlock x:Name="lblElementoInfo" FontSize="11" TextWrapping="Wrap" Foreground="#333"/>
                    </StackPanel>

                    <!-- ListBox de parámetros editables -->
                    <ListBox Grid.Row="2" x:Name="lstParametros"
                             BorderBrush="#D0D0D0" BorderThickness="1" Padding="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11"/>
                                            <TextBox x:Name="txtValue" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="4,2" FontSize="10" Margin="0,4,0,0"
                                                     Tag="{Binding Name}"/>
                                            <TextBlock Foreground="#999" FontSize="9" Margin="0,2,0,0">
                                                <Run Text="Tipo: "/>
                                                <Run Text="{Binding StorageType}"/>
                                                <Run Text=" | "/>
                                                <Run Text="{Binding IsInstance, StringFormat='{0:Instancia/Tipo}'}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Botones de acción -->
                    <StackPanel Grid.Row="3" Orientation="Vertical" Margin="0,10,0,0" Gap="6">
                        <Button Content="💾 Guardar cambios" Style="{StaticResource BtnPrimary}"
                                Click="BtnGuardarCambios_Click" FontSize="11"/>
                        <Button x:Name="btnAplicarSimilares" Content="↗️ Aplicar a similares" Style="{StaticResource BtnAction}"
                                Click="BtnAplicarSimilares_Click" FontSize="11" IsEnabled="False"
                                ToolTip="Copia este valor a otros elementos de la misma familia"/>
                        <Button Content="➕ Agregar parámetro" Style="{StaticResource BtnSecondary}"
                                Click="BtnAgregarParametro_Click" FontSize="11"
                                ToolTip="Crea el parámetro si no existe"/>
                    </StackPanel>

                    <!-- Mensaje de estado -->
                    <TextBlock Grid.Row="4" x:Name="lblStatusPanel"
                               Foreground="#666" FontSize="10" TextWrapping="Wrap"
                               Margin="0,8,0,0" Text="Selecciona un elemento para editar"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Resumen y pie -->
        <Border Grid.Row="5" Background="#ECEFF1" CornerRadius="4" Padding="10,7" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="lblResumen"
                           Text="Ejecute la validación para ver los resultados."
                           FontSize="11" VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="⚡  AUTO FIX (en desarrollo)"
                        Style="{StaticResource BtnAction}"
                        Click="BtnAutoFix_Click"
                        ToolTip="Corrección automática de parámetros"/>
            </Grid>
        </Border>
    </Grid>
</Window>
