<Window x:Class="MiNamespace.UI.UiValidadorParametros"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MiNamespace.UI"
        Title="Validador de Parámetros — BIM Governance"
        Height="760" Width="1440"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:SeveridadToColorConverter    x:Key="SevColor"/>
        <local:SeveridadToTextConverter     x:Key="SevText"/>
        <local:ComplianceToBarColorConverter x:Key="ComplianceBarColor"/>

        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="#2D6A4F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1B4332"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnSecondary" TargetType="Button">
            <Setter Property="Background" Value="#546E7A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#37474F"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnAction" TargetType="Button">
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0D47A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnMicro" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#1565C0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#0D47A1"/>
                    <Setter Property="TextBlock.TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="KpiCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#BDBDBD" BlurRadius="6" ShadowDepth="1" Opacity="0.5"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid row colors -->
        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severidad}" Value="Critico">
                    <Setter Property="Background" Value="#FFEBEE"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severidad}" Value="Advertencia">
                    <Setter Property="Background" Value="#FFF8E1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding TipoDeProblema}" Value="Duplicado">
                    <Setter Property="Background" Value="#E8EAF6"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding TipoDeProblema}" Value="AlcanceIncorrecto">
                    <Setter Property="Background" Value="#FFF3E0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarDisciplineHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#ECEFF1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="SidebarCategory" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B0BEC5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="16,2,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header -->
            <RowDefinition Height="Auto"/>   <!-- Toolbar -->
            <RowDefinition Height="Auto"/>   <!-- KPI Cards -->
            <RowDefinition Height="*"/>      <!-- Main content -->
            <RowDefinition Height="Auto"/>   <!-- Auto Fix footer -->
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" Background="#1A237E" Padding="16,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="▣ " FontSize="16" Foreground="#90CAF9" VerticalAlignment="Center"/>
                    <TextBlock Text="Validador de Parámetros" FontSize="17" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="  BIM GOVERNANCE PLATFORM" FontSize="10" Foreground="#7986CB" VerticalAlignment="Bottom" Margin="8,0,0,2"/>
                </StackPanel>
                <TextBlock Text="DICTA v2.3" HorizontalAlignment="Right" Foreground="#7986CB" VerticalAlignment="Center" FontSize="11"/>
            </Grid>
        </Border>

        <!-- ═══ TOOLBAR ═══ -->
        <Border Grid.Row="1" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="12,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Excel:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11"/>
                <TextBox Grid.Column="1" x:Name="txtExcelPath" IsReadOnly="True" VerticalContentAlignment="Center"
                         Padding="6,3" FontSize="10" Foreground="#555" Background="#FAFAFA" BorderBrush="#BDBDBD"/>
                <Button Grid.Column="2" Content="Examinar" Style="{StaticResource BtnSecondary}" Margin="5,0,0,0" Click="BtnExaminar_Click"/>
                <Button Grid.Column="3" Content="Crear plantilla" Style="{StaticResource BtnSecondary}" Margin="3,0,0,0" Click="BtnCrearPlantilla_Click"/>
                <Button Grid.Column="4" Content="Editar Excel" Style="{StaticResource BtnSecondary}" Margin="3,0,0,0" Click="BtnEditarExcel_Click"/>

                <Separator Grid.Column="5" Margin="6,0"/>

                <TextBlock Grid.Column="6" Text="Disciplina:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11"/>
                <ComboBox Grid.Column="7" x:Name="cboDisciplina" VerticalContentAlignment="Center" Padding="6,4" FontSize="11"/>
                <Button Grid.Column="8" Content="▶  EJECUTAR VALIDACIÓN" Style="{StaticResource BtnPrimary}" Margin="8,0,0,0" Click="BtnValidar_Click"/>
            </Grid>
        </Border>

        <!-- ═══ KPI CARDS ═══ -->
        <Border Grid.Row="2" Background="#ECEFF1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <TextBlock Text="Familias revisadas" FontSize="10" Foreground="#757575"/>
                        <TextBlock x:Name="kpiFamilias" Text="—" FontSize="26" FontWeight="Bold" Foreground="#1A237E"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <TextBlock Text="Parámetros faltantes" FontSize="10" Foreground="#757575"/>
                        <TextBlock x:Name="kpiFaltantes" Text="—" FontSize="26" FontWeight="Bold" Foreground="#B71C1C"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <TextBlock Text="Duplicados / Alcance incorrecto" FontSize="10" Foreground="#757575"/>
                        <TextBlock x:Name="kpiDuplicados" Text="—" FontSize="26" FontWeight="Bold" Foreground="#E65100"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <TextBlock Text="Compliance general" FontSize="10" Foreground="#757575"/>
                        <TextBlock x:Name="kpiCompliance" Text="—" FontSize="26" FontWeight="Bold" Foreground="#2D6A4F"/>
                        <ProgressBar x:Name="pgCompliance" Height="5" Minimum="0" Maximum="100" Margin="0,4,0,0"
                                     Foreground="#2D6A4F" Background="#E0E0E0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══ MAIN CONTENT ═══ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="180"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR: Discipline Navigation -->
            <Border Grid.Column="0" Background="#263238">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1C2C34" Padding="12,8">
                        <TextBlock Text="DISCIPLINAS" FontSize="10" FontWeight="Bold" Foreground="#607D8B" LetterSpacing="1"/>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="lstDisciplinas">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0,2">
                                        <StackPanel>
                                            <!-- Discipline header -->
                                            <Border Padding="12,8" Cursor="Hand">
                                                <Border.InputBindings>
                                                    <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.FiltrarDisciplinaCmd, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Nombre}"/>
                                                </Border.InputBindings>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Nombre}" Style="{StaticResource SidebarDisciplineHeader}"/>
                                                        <TextBlock Text="{Binding ResumenErrores}" FontSize="10" Foreground="#78909C" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding ComplianceTexto}"
                                                               FontSize="13" FontWeight="Bold" VerticalAlignment="Center"
                                                               Foreground="{Binding CompliancePct, Converter={StaticResource ComplianceBarColor}}"/>
                                                </Grid>
                                            </Border>

                                            <!-- Compliance bar -->
                                            <ProgressBar Value="{Binding CompliancePct}" Minimum="0" Maximum="100"
                                                         Height="3" Margin="12,0,12,4"
                                                         Foreground="{Binding CompliancePct, Converter={StaticResource ComplianceBarColor}}"
                                                         Background="#37474F"/>

                                            <!-- Categories -->
                                            <ItemsControl ItemsSource="{Binding Categorias}" Margin="0,0,0,6">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="16,1,12,1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Nombre}" Style="{StaticResource SidebarCategory}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding TotalErrores}" FontSize="10" Foreground="#EF9A9A" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Separator Background="#37474F" Margin="12,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#B0BEC5" Cursor="SizeWE"/>

            <!-- RIGHT CONTENT -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- Filters -->
                    <RowDefinition Height="*"/>      <!-- DataGrid + Edit panel -->
                </Grid.RowDefinitions>

                <!-- FILTERS BAR -->
                <Border Grid.Row="0" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="12,7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <CheckBox x:Name="chkSoloCriticos"  Content="Solo críticos"  Margin="0,0,14,0" FontSize="11" Checked="FiltroChanged" Unchecked="FiltroChanged"/>
                            <CheckBox x:Name="chkSoloFaltantes" Content="Solo faltantes" Margin="0,0,14,0" FontSize="11" Checked="FiltroChanged" Unchecked="FiltroChanged"/>
                            <CheckBox x:Name="chkSoloTipo"      Content="Solo Tipo"      Margin="0,0,14,0" FontSize="11" Checked="FiltroChanged" Unchecked="FiltroChanged"/>
                            <CheckBox x:Name="chkSoloInstancia" Content="Solo Instancia" Margin="0,0,20,0" FontSize="11" Checked="FiltroChanged" Unchecked="FiltroChanged"/>
                            <TextBlock Text="Buscar:" VerticalAlignment="Center" FontSize="11" Margin="0,0,6,0"/>
                            <TextBox x:Name="txtFiltroTexto" Width="160" Padding="5,3" FontSize="11" BorderBrush="#BDBDBD" TextChanged="FiltroChanged"/>
                        </WrapPanel>
                        <TextBlock Grid.Column="1" x:Name="lblFiltroInfo" VerticalAlignment="Center" FontSize="11" Foreground="#757575"/>
                    </Grid>
                </Border>

                <!-- DATA GRID + EDIT PANEL -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition x:Name="colEdicion" Width="320" MinWidth="0"/>
                    </Grid.ColumnDefinitions>

                    <!-- VALIDATION TABLE -->
                    <DataGrid Grid.Column="0"
                              x:Name="dgResultados"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              SelectionMode="Single"
                              SelectionChanged="DgResultados_SelectionChanged"
                              FontSize="11"
                              ColumnHeaderHeight="30"
                              RowHeight="30">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#ECEFF1"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="8,5"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="BorderBrush" Value="#CFD8DC"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <!-- Estado (severity dot) -->
                            <DataGridTemplateColumn Header="Estado" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Severidad, Converter={StaticResource SevText}}"
                                                       Foreground="{Binding Severidad, Converter={StaticResource SevColor}}"
                                                       FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Parámetro"  Binding="{Binding Parametro}"          Width="150"/>
                            <DataGridTextColumn Header="Alcance"    Binding="{Binding Alcance}"             Width="80"/>
                            <DataGridTextColumn Header="Categoría"  Binding="{Binding Categoria}"           Width="150"/>
                            <DataGridTextColumn Header="Familia"    Binding="{Binding Familia}"             Width="130"/>
                            <DataGridTextColumn Header="Problema"   Binding="{Binding TipoProblemaTexto}"   Width="130"/>
                            <DataGridTextColumn Header="Valor actual" Binding="{Binding ValorActual}"       Width="100"/>
                            <DataGridTextColumn Header="Descripción" Binding="{Binding DescripcionProblema}" Width="*"/>

                            <!-- Quick actions -->
                            <DataGridTemplateColumn Header="Acción" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Corregir" Style="{StaticResource BtnMicro}"
                                                Click="BtnCorregirFila_Click" Tag="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#E0E0E0" Cursor="SizeWE"/>

                    <!-- EDIT PANEL -->
                    <Border Grid.Column="2" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1,0,0,0" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Panel header -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="EDITAR PARÁMETROS" FontWeight="Bold" FontSize="12" Foreground="#1A237E"/>
                            </Grid>

                            <!-- Element info -->
                            <Border Grid.Row="1" Background="#ECEFF1" CornerRadius="4" Padding="8,6" Margin="0,0,0,10">
                                <TextBlock x:Name="lblElementoInfo" FontSize="11" TextWrapping="Wrap" Foreground="#37474F"
                                           Text="Selecciona un elemento del grid"/>
                            </Border>

                            <!-- Parameter list -->
                            <ListBox Grid.Row="2" x:Name="lstParametros"
                                     BorderBrush="#D0D0D0" BorderThickness="1"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,6" BorderBrush="#EEE" BorderThickness="0,0,0,1">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11"/>
                                                    <TextBlock Text="{Binding StorageType}" HorizontalAlignment="Right"
                                                               FontSize="9" Foreground="#999" VerticalAlignment="Center"/>
                                                </Grid>
                                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                         Padding="4,2" FontSize="11" Margin="0,4,0,2"
                                                         BorderBrush="#BDBDBD"/>
                                                <TextBlock FontSize="9" Foreground="#B0BEC5">
                                                    <Run Text="{Binding IsInstance, StringFormat='Instancia: {0}'}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Action buttons -->
                            <StackPanel Grid.Row="3" Margin="0,10,0,0">
                                <Button Content="💾  Guardar cambios" Style="{StaticResource BtnPrimary}"
                                        Margin="0,0,0,4" Click="BtnGuardarCambios_Click" FontSize="11"/>
                                <Button x:Name="btnAplicarSimilares" Content="↗  Aplicar a similares (instancia)"
                                        Style="{StaticResource BtnAction}"
                                        Margin="0,0,0,4" Click="BtnAplicarSimilares_Click" FontSize="11"
                                        IsEnabled="False"
                                        ToolTip="Solo parámetros de instancia — copia el valor a elementos de la misma familia"/>
                                <Button Content="＋  Agregar parámetro" Style="{StaticResource BtnSecondary}"
                                        Click="BtnAgregarParametro_Click" FontSize="11"/>
                            </StackPanel>

                            <TextBlock Grid.Row="4" x:Name="lblStatusPanel" Foreground="#90A4AE" FontSize="10"
                                       TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ═══ AUTO FIX FOOTER ═══ -->
        <Border Grid.Row="4" Background="#0D47A1" Padding="14,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="16" Foreground="#90CAF9" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="lblAutoFixInfo"
                                   Text="Ejecuta la validación para obtener el resumen de correcciones disponibles."
                                   Foreground="#90CAF9" FontSize="12"/>
                        <TextBlock x:Name="lblAutoFixDetalle" Foreground="#7986CB" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Content="EJECUTAR AUTO FIX"
                        Style="{StaticResource BtnPrimary}"
                        Background="#1B5E20"
                        Click="BtnAutoFix_Click"
                        Padding="16,8"
                        ToolTip="Corrección automática basada en reglas del Excel"/>
            </Grid>
        </Border>
    </Grid>
</Window>
