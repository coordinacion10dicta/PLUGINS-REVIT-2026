<Window x:Class="MiNamespace.UI.UiValidadorParametros"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MiNamespace.UI"
        Title="Validador de Parámetros — BIM Governance"
        Height="760" Width="1440"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:SeveridadToColorConverter     x:Key="SevColor"/>
        <local:SeveridadToTextConverter      x:Key="SevText"/>
        <local:ComplianceToBarColorConverter x:Key="ComplianceBarColor"/>
        <local:TipoBloqueToColorConverter    x:Key="TipoBloqueColor"/>

        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="#2D6A4F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1B4332"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnSecondary" TargetType="Button">
            <Setter Property="Background" Value="#546E7A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#37474F"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnAction" TargetType="Button">
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0D47A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnDanger" TargetType="Button">
            <Setter Property="Background" Value="#C62828"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B71C1C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnMicro" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#1565C0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#0D47A1"/>
                    <Setter Property="TextBlock.TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="KpiCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#BDBDBD" BlurRadius="6" ShadowDepth="1" Opacity="0.5"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CrudPanelHeader" TargetType="Border">
            <Setter Property="Background" Value="#1A237E"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>

        <Style x:Key="CrudPanelHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- DataGrid row colors (validación) -->
        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severidad}" Value="Critico">
                    <Setter Property="Background" Value="#FFEBEE"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severidad}" Value="Advertencia">
                    <Setter Property="Background" Value="#FFF8E1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding TipoDeProblema}" Value="Duplicado">
                    <Setter Property="Background" Value="#E8EAF6"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding TipoDeProblema}" Value="AlcanceIncorrecto">
                    <Setter Property="Background" Value="#FFF3E0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarDisciplineHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#ECEFF1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="SidebarCategory" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B0BEC5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="16,2,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header -->
            <RowDefinition Height="Auto"/>   <!-- Toolbar -->
            <RowDefinition Height="*"/>      <!-- TabControl -->
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" Background="#1A237E" Padding="16,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="▣ " FontSize="16" Foreground="#90CAF9" VerticalAlignment="Center"/>
                    <TextBlock Text="Validador de Parámetros" FontSize="17" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="  BIM GOVERNANCE PLATFORM" FontSize="10" Foreground="#7986CB" VerticalAlignment="Bottom" Margin="8,0,0,2"/>
                </StackPanel>
                <TextBlock Text="DICTA v2.3" HorizontalAlignment="Right" Foreground="#7986CB" VerticalAlignment="Center" FontSize="11"/>
            </Grid>
        </Border>

        <!-- ═══ TOOLBAR ═══ -->
        <Border Grid.Row="1" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="12,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Disciplina:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11"/>
                <ComboBox Grid.Column="1" x:Name="cboDisciplina" VerticalContentAlignment="Center" Padding="6,4" FontSize="11"
                          SelectionChanged="CboDisciplina_SelectionChanged"/>
                <TextBlock Grid.Column="2" Text="Categoría:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,8,0" FontSize="11"/>
                <ComboBox Grid.Column="3" x:Name="cboCategoriaFiltro" VerticalContentAlignment="Center" Padding="6,4" FontSize="11"/>
                <Button Grid.Column="4" x:Name="BtnValidar" Content="▶  EJECUTAR VALIDACIÓN" Style="{StaticResource BtnPrimary}" Margin="8,0,0,0" Click="BtnValidar_Click"/>
                <TextBlock Grid.Column="5" x:Name="lblValidandoStatus" Text="" Foreground="#1565C0" FontStyle="Italic"
                           VerticalAlignment="Center" Margin="14,0,0,0" FontSize="11"/>
            </Grid>
        </Border>

        <!-- ═══ TAB CONTROL ═══ -->
        <TabControl Grid.Row="2" x:Name="tcMain" SelectionChanged="TabControl_SelectionChanged">

            <!-- ══ TAB VALIDACIÓN ══ -->
            <TabItem x:Name="tabValidacion" Header="  Validación  ">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- KPI Cards -->
                        <RowDefinition Height="*"/>      <!-- Main content -->
                        <RowDefinition Height="Auto"/>   <!-- Auto Fix footer -->
                    </Grid.RowDefinitions>

                    <!-- KPI CARDS -->
                    <Border Grid.Row="0" Background="#ECEFF1" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource KpiCard}">
                                <StackPanel>
                                    <TextBlock Text="Familias revisadas" FontSize="10" Foreground="#757575"/>
                                    <TextBlock x:Name="kpiFamilias" Text="—" FontSize="26" FontWeight="Bold" Foreground="#1A237E"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource KpiCard}">
                                <StackPanel>
                                    <TextBlock Text="Parámetros faltantes" FontSize="10" Foreground="#757575"/>
                                    <TextBlock x:Name="kpiFaltantes" Text="—" FontSize="26" FontWeight="Bold" Foreground="#B71C1C"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource KpiCard}">
                                <StackPanel>
                                    <TextBlock Text="Duplicados / Alcance incorrecto" FontSize="10" Foreground="#757575"/>
                                    <TextBlock x:Name="kpiDuplicados" Text="—" FontSize="26" FontWeight="Bold" Foreground="#E65100"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" Style="{StaticResource KpiCard}">
                                <StackPanel>
                                    <TextBlock Text="Compliance general" FontSize="10" Foreground="#757575"/>
                                    <TextBlock x:Name="kpiCompliance" Text="—" FontSize="26" FontWeight="Bold" Foreground="#2D6A4F"/>
                                    <ProgressBar x:Name="pgCompliance" Height="5" Minimum="0" Maximum="100" Margin="0,4,0,0"
                                                 Foreground="#2D6A4F" Background="#E0E0E0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- MAIN CONTENT: sidebar + datagrid + edit panel -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" MinWidth="180"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT SIDEBAR -->
                        <Border Grid.Column="0" Background="#263238">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#1C2C34" Padding="12,8">
                                    <TextBlock Text="DISCIPLINAS" FontSize="10" FontWeight="Bold" Foreground="#607D8B"/>
                                </Border>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="lstDisciplinas">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="0,2">
                                                    <StackPanel>
                                                        <Border Padding="12,8" Cursor="Hand">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0">
                                                                    <TextBlock Text="{Binding Nombre}" Style="{StaticResource SidebarDisciplineHeader}"/>
                                                                    <TextBlock Text="{Binding ResumenErrores}" FontSize="10" Foreground="#78909C" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" Text="{Binding ComplianceTexto}"
                                                                           FontSize="13" FontWeight="Bold" VerticalAlignment="Center"
                                                                           Foreground="{Binding CompliancePct, Converter={StaticResource ComplianceBarColor}}"/>
                                                            </Grid>
                                                        </Border>
                                                        <ProgressBar Value="{Binding CompliancePct}" Minimum="0" Maximum="100"
                                                                     Height="3" Margin="12,0,12,4"
                                                                     Foreground="{Binding CompliancePct, Converter={StaticResource ComplianceBarColor}}"
                                                                     Background="#37474F"/>
                                                        <ItemsControl ItemsSource="{Binding Categorias}" Margin="0,0,0,6">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="16,1,12,1">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="{Binding Nombre}" Style="{StaticResource SidebarCategory}"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding TotalErrores}" FontSize="10" Foreground="#EF9A9A" VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <Separator Background="#37474F" Margin="12,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#B0BEC5" Cursor="SizeWE"/>

                        <!-- RIGHT CONTENT: filters + datagrid + edit panel -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- FILTERS BAR -->
                            <Border Grid.Row="0" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="12,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                        <CheckBox x:Name="chkSoloCriticos"  Content="Solo críticos"  Margin="0,0,14,0" FontSize="11" Checked="FiltroChanged" Unchecked="FiltroChanged"/>
                                        <CheckBox x:Name="chkSoloFaltantes" Content="Solo faltantes" Margin="0,0,14,0" FontSize="11" Checked="FiltroChanged" Unchecked="FiltroChanged"/>
                                        <CheckBox x:Name="chkSoloTipo"      Content="Solo Tipo"      Margin="0,0,14,0" FontSize="11" Checked="FiltroChanged" Unchecked="FiltroChanged"/>
                                        <CheckBox x:Name="chkSoloInstancia" Content="Solo Instancia" Margin="0,0,20,0" FontSize="11" Checked="FiltroChanged" Unchecked="FiltroChanged"/>
                                        <TextBlock Text="Buscar:" VerticalAlignment="Center" FontSize="11" Margin="0,0,6,0"/>
                                        <TextBox x:Name="txtFiltroTexto" Width="160" Padding="5,3" FontSize="11" BorderBrush="#BDBDBD" TextChanged="FiltroChanged"/>
                                    </WrapPanel>
                                    <TextBlock Grid.Column="1" x:Name="lblFiltroInfo" VerticalAlignment="Center" FontSize="11" Foreground="#757575"/>
                                </Grid>
                            </Border>

                            <!-- DATA GRID + EDIT PANEL -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition x:Name="colEdicion" Width="320" MinWidth="0"/>
                                </Grid.ColumnDefinitions>

                                <DataGrid Grid.Column="0"
                                          x:Name="dgResultados"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          SelectionMode="Single"
                                          SelectionChanged="DgResultados_SelectionChanged"
                                          FontSize="11"
                                          ColumnHeaderHeight="30"
                                          RowHeight="30">

                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#ECEFF1"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="FontSize" Value="11"/>
                                            <Setter Property="Padding" Value="8,5"/>
                                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                            <Setter Property="BorderBrush" Value="#CFD8DC"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>

                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Estado" Width="60">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Severidad, Converter={StaticResource SevText}}"
                                                                   Foreground="{Binding Severidad, Converter={StaticResource SevColor}}"
                                                                   FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="Parámetro"   Binding="{Binding Parametro}"          Width="150"/>
                                        <DataGridTextColumn Header="Alcance"     Binding="{Binding Alcance}"             Width="80"/>
                                        <DataGridTextColumn Header="Categoría"   Binding="{Binding Categoria}"           Width="150"/>
                                        <DataGridTextColumn Header="Familia"     Binding="{Binding Familia}"             Width="130"/>
                                        <DataGridTextColumn Header="Problema"    Binding="{Binding TipoProblemaTexto}"   Width="130"/>
                                        <DataGridTextColumn Header="Valor actual" Binding="{Binding ValorActual}"        Width="100"/>
                                        <DataGridTextColumn Header="Descripción" Binding="{Binding DescripcionProblema}" Width="*"/>

                                        <DataGridTemplateColumn Header="Acción" Width="70">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Corregir" Style="{StaticResource BtnMicro}"
                                                            Click="BtnCorregirFila_Click" Tag="{Binding}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#E0E0E0" Cursor="SizeWE"/>

                                <!-- EDIT PANEL -->
                                <Border Grid.Column="2" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1,0,0,0" Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="0,0,0,10">
                                            <TextBlock Text="EDITAR PARÁMETROS" FontWeight="Bold" FontSize="12" Foreground="#1A237E"/>
                                        </Grid>

                                        <Border Grid.Row="1" Background="#ECEFF1" CornerRadius="4" Padding="8,6" Margin="0,0,0,10">
                                            <TextBlock x:Name="lblElementoInfo" FontSize="11" TextWrapping="Wrap" Foreground="#37474F"
                                                       Text="Selecciona un elemento del grid"/>
                                        </Border>

                                        <ListBox Grid.Row="2" x:Name="lstParametros"
                                                 BorderBrush="#D0D0D0" BorderThickness="1"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="8,6" BorderBrush="#EEE" BorderThickness="0,0,0,1">
                                                        <StackPanel>
                                                            <Grid>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11"/>
                                                                <TextBlock Text="{Binding StorageType}" HorizontalAlignment="Right"
                                                                           FontSize="9" Foreground="#999" VerticalAlignment="Center"/>
                                                            </Grid>
                                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                     Padding="4,2" FontSize="11" Margin="0,4,0,2"
                                                                     BorderBrush="#BDBDBD"/>
                                                            <TextBlock FontSize="9" Foreground="#B0BEC5">
                                                                <Run Text="{Binding IsInstance, StringFormat='Instancia: {0}'}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <StackPanel Grid.Row="3" Margin="0,10,0,0">
                                            <Button Content="Guardar cambios" Style="{StaticResource BtnPrimary}"
                                                    Margin="0,0,0,4" Click="BtnGuardarCambios_Click" FontSize="11"/>
                                            <Button x:Name="btnAplicarSimilares" Content="Aplicar a similares (instancia)"
                                                    Style="{StaticResource BtnAction}"
                                                    Margin="0,0,0,4" Click="BtnAplicarSimilares_Click" FontSize="11"
                                                    IsEnabled="False"
                                                    ToolTip="Solo parámetros de instancia — copia el valor a elementos de la misma familia"/>
                                            <Button Content="+ Agregar parámetro" Style="{StaticResource BtnSecondary}"
                                                    Click="BtnAgregarParametro_Click" FontSize="11"/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="4" x:Name="lblStatusPanel" Foreground="#90A4AE" FontSize="10"
                                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- AUTO FIX FOOTER -->
                    <Border Grid.Row="2" Background="#0D47A1" Padding="14,10">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚡" FontSize="16" Foreground="#90CAF9" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="lblAutoFixInfo"
                                               Text="Ejecuta la validación para obtener el resumen de correcciones disponibles."
                                               Foreground="#90CAF9" FontSize="12"/>
                                    <TextBlock x:Name="lblAutoFixDetalle" Foreground="#7986CB" FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Content="EJECUTAR AUTO FIX"
                                    Style="{StaticResource BtnPrimary}"
                                    Background="#1B5E20"
                                    Click="BtnAutoFix_Click"
                                    Padding="16,8"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="  ⚙ Configuración  ">
                <Grid Background="#F5F5F5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" MinWidth="160"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="220" MinWidth="160"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ── PANEL DISCIPLINAS ── -->
                    <Grid Grid.Column="0" Background="White">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource CrudPanelHeader}">
                            <TextBlock Text="DISCIPLINAS" Style="{StaticResource CrudPanelHeaderText}"/>
                        </Border>

                        <ListBox Grid.Row="1" x:Name="lstCrudDisciplinas"
                                 BorderThickness="0"
                                 SelectionChanged="LstCrudDisciplinas_SelectionChanged"
                                 FontSize="12" Padding="4"/>

                        <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="8">
                            <StackPanel>
                                <TextBox x:Name="txtNuevaDisciplina" Padding="5,4" FontSize="11" Margin="0,0,0,5"
                                         BorderBrush="#BDBDBD" ToolTip="Nombre de la nueva disciplina"/>
                                <WrapPanel>
                                    <Button Content="+ Agregar" Style="{StaticResource BtnPrimary}"
                                            FontSize="10" Padding="8,4" Margin="0,0,4,0"
                                            Click="BtnAgregarDisciplina_Click"/>
                                    <Button Content="- Eliminar" Style="{StaticResource BtnDanger}"
                                            FontSize="10" Padding="8,4"
                                            Click="BtnEliminarDisciplina_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#E0E0E0" Cursor="SizeWE"/>

                    <!-- ── PANEL CATEGORÍAS ── -->
                    <Grid Grid.Column="2" Background="White">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource CrudPanelHeader}">
                            <TextBlock x:Name="lblCategoriasTitulo" Text="Categorías" Style="{StaticResource CrudPanelHeaderText}"/>
                        </Border>

                        <ListBox Grid.Row="1" x:Name="lstCrudCategorias"
                                 BorderThickness="0"
                                 SelectionChanged="LstCrudCategorias_SelectionChanged"
                                 FontSize="11" Padding="2">

                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,4" Margin="0,2,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#37474F"/>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Name}" Foreground="White"
                                                           FontWeight="Bold" FontSize="10"/>
                                            </Border>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Nombre}" Padding="4,2">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Agregada}" Value="True">
                                                        <Setter Property="Foreground" Value="#2D6A4F"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="8">
                            <StackPanel>
                                <TextBox x:Name="txtNuevaCategoria" Padding="5,4" FontSize="11" Margin="0,0,0,5"
                                         BorderBrush="#BDBDBD" ToolTip="Nombre de la nueva categoría Revit"
                                         TextChanged="TxtNuevaCategoria_TextChanged"/>
                                <WrapPanel>
                                    <Button Content="+ Agregar" Style="{StaticResource BtnPrimary}"
                                            FontSize="10" Padding="8,4" Margin="0,0,4,0"
                                            Click="BtnAgregarCategoria_Click"/>
                                    <Button Content="- Eliminar" Style="{StaticResource BtnDanger}"
                                            FontSize="10" Padding="8,4"
                                            Click="BtnEliminarCategoria_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="#E0E0E0" Cursor="SizeWE"/>

                    <!-- ── PANEL ESTRUCTURA ── -->
                    <Grid Grid.Column="4" Background="White">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource CrudPanelHeader}">
                            <TextBlock x:Name="lblParametrosTitulo" Text="Estructura" Style="{StaticResource CrudPanelHeaderText}"/>
                        </Border>

                        <TabControl Grid.Row="1" BorderThickness="0">

                            <!-- TAB VALIDACIÓN -->
                            <TabItem Header="Validación">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <DataGrid Grid.Row="0" x:Name="dgCrudParametros"
                                              AutoGenerateColumns="False" CanUserAddRows="False"
                                              CanUserDeleteRows="False" HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal" SelectionMode="Single"
                                              FontSize="11" ColumnHeaderHeight="28" RowHeight="30"
                                              CellEditEnding="DgCrudParametros_CellEditEnding">
                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="#ECEFF1"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="FontSize" Value="11"/>
                                                <Setter Property="Padding" Value="8,4"/>
                                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                                <Setter Property="BorderBrush" Value="#CFD8DC"/>
                                            </Style>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Parámetro" Binding="{Binding Nombre, UpdateSourceTrigger=LostFocus}" Width="*"/>
                                            <DataGridTemplateColumn Header="Alcance" Width="85">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Alcance}" VerticalAlignment="Center" Margin="6,0"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate>
                                                        <ComboBox SelectedItem="{Binding Alcance, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="4,2">
                                                            <ComboBoxItem>Tipo</ComboBoxItem>
                                                            <ComboBoxItem>Instancia</ComboBoxItem>
                                                        </ComboBox>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridCheckBoxColumn Header="Obligatorio" Binding="{Binding Obligatorio, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Border Grid.Row="1" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="8,5">
                                        <WrapPanel>
                                            <Button Content="+ Agregar" Style="{StaticResource BtnPrimary}"
                                                    FontSize="10" Padding="10,4" Margin="0,0,4,0"
                                                    Click="BtnAgregarParamCrud_Click"/>
                                            <Button Content="📋 De familia" Style="{StaticResource BtnAction}"
                                                    FontSize="10" Padding="10,4" Margin="0,0,4,0"
                                                    Click="BtnBuscarParamFamilia_Click"/>
                                            <Button Content="- Eliminar" Style="{StaticResource BtnDanger}"
                                                    FontSize="10" Padding="10,4"
                                                    Click="BtnEliminarParamCrud_Click"/>
                                        </WrapPanel>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <!-- TAB DESCRIPCIÓN -->
                            <TabItem Header="Descripción">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>      <!-- keywords -->
                                        <RowDefinition Height="5"/>      <!-- splitter -->
                                        <RowDefinition Height="200"/>    <!-- plantilla -->
                                    </Grid.RowDefinitions>

                                    <!-- KEYWORDS -->
                                    <Grid Grid.Row="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Background="#37474F" Padding="8,5">
                                            <TextBlock Text="PALABRAS CLAVE" Foreground="#CFD8DC" FontWeight="Bold" FontSize="10"/>
                                        </Border>

                                        <DataGrid Grid.Row="1" x:Name="dgKeywords"
                                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                                  CanUserDeleteRows="False" HeadersVisibility="Column"
                                                  GridLinesVisibility="Horizontal" SelectionMode="Single"
                                                  FontSize="11" ColumnHeaderHeight="26" RowHeight="28"
                                                  SelectionChanged="DgKeywords_SelectionChanged">
                                            <DataGrid.ColumnHeaderStyle>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="Background" Value="#ECEFF1"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="FontSize" Value="10"/>
                                                    <Setter Property="Padding" Value="6,3"/>
                                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                                    <Setter Property="BorderBrush" Value="#CFD8DC"/>
                                                </Style>
                                            </DataGrid.ColumnHeaderStyle>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Palabra clave" Binding="{Binding Nombre}" Width="*" IsReadOnly="True"/>
                                                <DataGridTemplateColumn Header="Parámetros asociados" Width="*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding ParametrosTexto}" FontSize="10"
                                                                       Foreground="#546E7A" VerticalAlignment="Center" Margin="4,0"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="+" Width="36">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="[+]" Foreground="#1565C0" FontSize="11"
                                                                       FontWeight="Bold" Cursor="Hand"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       MouseLeftButtonDown="KeywordAPlantilla_MouseDown"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="6,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" x:Name="txtNuevaKeyword"
                                                         Padding="5,3" FontSize="11" BorderBrush="#BDBDBD"
                                                         ToolTip="Nombre de la palabra clave (ej: diametro, marca)"/>
                                                <Button Grid.Column="1" Content="+ Agregar" Style="{StaticResource BtnPrimary}"
                                                        FontSize="10" Padding="8,3" Margin="4,0,0,0"
                                                        Click="BtnAgregarKeyword_Click"/>
                                                <Button Grid.Column="2" Content="Asociar param" Style="{StaticResource BtnAction}"
                                                        FontSize="10" Padding="8,3" Margin="4,0,0,0"
                                                        Click="BtnAsociarParamKeyword_Click"/>
                                                <Button Grid.Column="3" Content="- Eliminar" Style="{StaticResource BtnDanger}"
                                                        FontSize="10" Padding="8,3" Margin="4,0,0,0"
                                                        Click="BtnEliminarKeyword_Click"/>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="#E0E0E0"/>

                                    <!-- PLANTILLA -->
                                    <Grid Grid.Row="2" Background="#FAFAFA">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Background="#263238" Padding="8,4">
                                            <TextBlock Text="PLANTILLA DE DESCRIPCIÓN" Foreground="#90CAF9" FontWeight="Bold" FontSize="10"/>
                                        </Border>

                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="White">
                                            <ItemsControl x:Name="icPlantilla">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" Margin="4"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="2" Padding="6,3" CornerRadius="3"
                                                                Background="{Binding Tipo, Converter={StaticResource TipoBloqueColor}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Valor}" Foreground="White"
                                                                           FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                <TextBlock Text="  ←" Foreground="#CFD8DC" FontSize="11"
                                                                           Cursor="Hand" VerticalAlignment="Center"
                                                                           MouseLeftButtonDown="BloqueSubir_MouseDown"/>
                                                                <TextBlock Text="→" Foreground="#CFD8DC" FontSize="11"
                                                                           Cursor="Hand" VerticalAlignment="Center"
                                                                           MouseLeftButtonDown="BloqueBajar_MouseDown"/>
                                                                <TextBlock Text="  ×" Foreground="#EF9A9A" FontSize="13"
                                                                           Cursor="Hand" VerticalAlignment="Center"
                                                                           MouseLeftButtonDown="BloqueEliminar_MouseDown"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <Grid Grid.Row="2" Margin="6,4,6,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" x:Name="txtBloqueTexto"
                                                     Padding="5,3" FontSize="11" BorderBrush="#BDBDBD"
                                                     ToolTip="Texto fijo o conector"/>
                                            <Button Grid.Column="1" Content="+ Texto" Style="{StaticResource BtnSecondary}"
                                                    FontSize="10" Padding="8,3" Margin="4,0,0,0"
                                                    Click="BtnAgregarTextoBloque_Click"/>
                                        </Grid>

                                        <Border Grid.Row="3" Background="#E8EAF6" Padding="8,5">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Preview: " FontSize="10" Foreground="#3949AB"
                                                           FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock x:Name="lblPlantillaPreview" FontSize="11"
                                                           Foreground="#263238" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </TabItem>
                        </TabControl>

                        <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="8,6">
                            <Button Content="💾 Guardar cambios" Style="{StaticResource BtnPrimary}"
                                    FontSize="10" Padding="12,4" HorizontalAlignment="Right"
                                    Click="BtnGuardarConfiguracion_Click"/>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
